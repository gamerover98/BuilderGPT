# ==============================================================================
# BuilderGPT Environment Variables
# ==============================================================================

# AI Model Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# If using Gemini natively, you might also need to set this:
GOOGLE_API_KEY=

# LLM Provider Configuration
# Supported options in cynia_agents typically include: openai, google, anthropic
# Note: If you enter "gemini", cynia_agents might not recognize it and fall back to OpenAI.
# Use "google" for native Gemini, or "openai" with Gemini's compatible BASE_URL.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-pro

# To use Gemini via OpenAI Compatibility API, set LLM_PROVIDER=openai and configure:
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=your_gemini_api_key_here
